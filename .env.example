# SUNUPILOT — Docker production/local bootstrap
# Remplacez TOUTES les valeurs CHANGE_ME avant usage (aucun secret n'est généré automatiquement).
# NODE_ENV=production active la validation stricte (HTTPS, JWT_SECRET >= 32 car., BACKUP_ENCRYPTION_KEY,
# DATA_ENCRYPTION_KEY). Pour un test local en HTTP, utilisez docker-compose.yml seul (NODE_ENV=development).
DB_ROOT_PASSWORD=CHANGE_ME_ROOT
# Compte utilisé par le serveur et le worker : aucun droit CREATE/ALTER/DROP/TRIGGER.
DB_USER=samafacture_app
DB_PASSWORD=CHANGE_ME_APP
# Compte DDL réservé au démarrage et aux migrations ; doit être distinct de DB_USER en production.
DB_MIGRATION_USER=samafacture_migrator
DB_MIGRATION_PASSWORD=CHANGE_ME_MIGRATION
# Compte dédié à mysqldump : lecture et accès aux définitions des triggers uniquement.
DB_BACKUP_USER=samafacture_backup
DB_BACKUP_PASSWORD=CHANGE_ME_BACKUP
DB_NAME=samafacture
HTTP_PORT=4000
WEB_CONCURRENCY=2
DB_POOL_SIZE=20
DB_QUEUE_LIMIT=2000
ALLOWED_ORIGINS=http://localhost:4000
APP_URL=http://localhost:4000
JWT_SECRET=CHANGE_ME

# Chiffrement des secrets webhook et identifiants de paiement (OBLIGATOIRE en production) : générez une clé persistante avec `openssl rand -hex 32`.
# Ne la modifiez pas après création des webhooks, sinon leurs secrets ne pourront plus être déchiffrés.
DATA_ENCRYPTION_KEY=
# Clé de chiffrement des sauvegardes (64 caractères hexadécimaux : openssl rand -hex 32). Obligatoire en production.
BACKUP_ENCRYPTION_KEY=
# Registre d'audit append-only : clé HMAC dédiée recommandée, aléatoire, persistante et >= 32 octets (openssl rand -hex 32).
# En production, DATA_ENCRYPTION_KEY sert de repli dérivé si la clé dédiée est absente ; une clé HMAC explicite reste préférable.
# Ne jamais régénérer/modifier une clé source sur une base existante sans rotation versionnée.
AUDIT_LOG_HMAC_KEY=
AUDIT_LOG_HMAC_KEY_VERSION=1
# Facultatif lors d'une rotation : JSON version -> clé historique (conserver toutes les clés utilisées par les événements).
AUDIT_LOG_HMAC_KEYRING=
# Sécurité restauration : refus par défaut si la base cible contient déjà des objets SQL.
# Ne passez à true que pour un écrasement volontaire après vérification de la cible.
RESTORE_ALLOW_NON_EMPTY=false
# Fréquence de vérification de la file webhook (millisecondes, défaut 30000 = 30 s).
WEBHOOK_DELIVERY_INTERVAL_MS=30000
JWT_EXPIRES_IN=7d
NODE_ENV=production
TRUST_PROXY=1
REDIS_URL=redis://redis:6379
BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
MYSQLDUMP_PATH=mysqldump
BACKUP_ON_STARTUP=false
ENABLE_API_DOCS=false
PDF_JOBS_DIR=/app/server/pdf-jobs
PDF_QUEUE_KEY=samafacture:pdf:queue
PDF_JOB_TTL_SECONDS=3600
HEALTH_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
PAIEMENT_EXPIRATION_HEURES=24
PAYDUNYA_MODE=test

# Centre administrateur de la plateforme SUNUPILOT.
# ID numériques de comptes autorisés, séparés par des virgules. Ne pas utiliser users.role :
# ce rôle est celui d'un espace métier et ne donne aucun droit d'administration plateforme.
SUNUPILOT_ADMIN_USER_IDS=
# Secret HMAC dédié aux statistiques, long, aléatoire et stable (facultatif ; JWT_SECRET en repli).
SUNUPILOT_ANALYTICS_HASH_SECRET=
# Aucune vue analytique n'est supprimée automatiquement sans activation explicite.
SUNUPILOT_ANALYTICS_PURGE_ENABLED=false
# Durée en jours appliquée uniquement si la purge est explicitement activée (30 à 825, 395 par défaut).
SUNUPILOT_ANALYTICS_RETENTION_DAYS=395
