# SamaFacture Pro — Docker production/local bootstrap
# Ces secrets sont générés automatiquement pour cette archive. Changez-les avant une mise en production publique.
DB_ROOT_PASSWORD=CHANGE_ME
DB_USER=samafacture_app
DB_PASSWORD=CHANGE_ME
DB_NAME=samafacture
HTTP_PORT=4000
WEB_CONCURRENCY=2
DB_POOL_SIZE=20
DB_QUEUE_LIMIT=2000
ALLOWED_ORIGINS=http://localhost:4000
APP_URL=http://localhost:4000
JWT_SECRET=CHANGE_ME

# Chiffrement des secrets webhook (recommandé) : générez une clé persistante avec `openssl rand -hex 32`.
# Ne la modifiez pas après création des webhooks, sinon leurs secrets ne pourront plus être déchiffrés.
DATA_ENCRYPTION_KEY=
# Fréquence de vérification de la file webhook (millisecondes, défaut 30000 = 30 s).
WEBHOOK_DELIVERY_INTERVAL_MS=30000
JWT_EXPIRES_IN=7d
NODE_ENV=production
TRUST_PROXY=1
REDIS_URL=redis://redis:6379
BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_RETENTION_DAYS=14
BACKUP_DIR=./backups
MYSQLDUMP_PATH=mysqldump
BACKUP_ON_STARTUP=false
ENABLE_API_DOCS=false
PDF_JOBS_DIR=/app/server/pdf-jobs
PDF_QUEUE_KEY=samafacture:pdf:queue
PDF_JOB_TTL_SECONDS=3600
HEALTH_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
PAIEMENT_EXPIRATION_HEURES=24
PAYDUNYA_MODE=test
