# Reverse proxy pour plusieurs instances SamaFacture Pro.
# Docker Compose : `docker compose up -d --build` puis
# `docker compose up -d --scale app=3`.
# Pour une vraie production, terminez TLS ici (ou devant ce proxy) et utilisez un domaine réel.

events {}

http {
    # Caddy is the only public entry point. Restore the visitor IP from its
    # forwarded header before ip_hash chooses an API replica; otherwise every user
    # would appear to originate from the single Caddy container address.
    set_real_ip_from 172.16.0.0/12;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    resolver 127.0.0.11 valid=5s ipv6=off;
    map $http_upgrade $connection_upgrade { default upgrade; '' close; }

    # Ne journalise ni les query strings (reset token), ni les codes publics de facture/devis,
    # ni les jetons des liens de paiement placés dans le chemin, ni le Referer complet.
    map $uri $sf_log_uri {
        default $uri;
        ~*^(/api/public/(?:consulter|verifier)/[^/]+)/[^/]+$ $1/[redacted];
        ~*^(/api/public/paiement)/[^/]+$ $1/[redacted];
    }
    map $http_referer $sf_log_referer {
        default "-";
        ~^(https?://[^/]+) $1;
    }
    log_format sf_safe '$remote_addr - $remote_user [$time_local] "$request_method $sf_log_uri $server_protocol" $status $body_bytes_sent "$sf_log_referer" "$http_user_agent" $request_time';
    access_log /dev/stdout sf_safe;


    upstream samafacture_api {
        zone samafacture_api 64k;
        # ip_hash doit précéder keepalive pour conserver l'algorithme de routage sticky.
        # Avec Docker Compose, le DNS du service app peut retourner plusieurs réplicas.
        # Redis assure la diffusion des événements entre instances.
        ip_hash;
        keepalive 32;
        server app:4000 resolve;
    }

    server {
        listen 80;
        server_name _;
        client_max_body_size 8m;

        location / {
            proxy_pass http://samafacture_api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
      

            proxy_read_timeout 120s;
            proxy_send_timeout 120s; 
            proxy_buffering on;
            proxy_buffers 16 64k; 
            proxy_buffer_size 64k; 

           
        }
    }
}
# fix(nginx): corrige la troncature des PDF téléchargés (Connection upgrade forcé)
