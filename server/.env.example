PORT=4000
# Laissez cette valeur telle quelle : elle sera remplacée automatiquement par un secret
# aléatoire sécurisé au premier démarrage du serveur (voir server/config/secrets.js).
# Recommandé en déploiement Docker : générez-le vous-même avant le premier démarrage
# avec `openssl rand -hex 48` et collez le résultat ci-dessous. La génération automatique
# fonctionne aussi (server/.env est monté dans le conteneur, voir docker-compose.yml),
# mais dépend des permissions du fichier sur l'hôte : la définir à l'avance l'évite.
JWT_SECRET=change_this_secret_in_production

# Chiffrement des secrets webhook (recommandé) : générez une clé persistante avec `openssl rand -hex 32`.
# Ne la modifiez pas après création des webhooks, sinon leurs secrets ne pourront plus être déchiffrés.
DATA_ENCRYPTION_KEY=
# Fréquence de vérification de la file webhook (millisecondes, défaut 30000 = 30 s).
WEBHOOK_DELIVERY_INTERVAL_MS=30000
JWT_EXPIRES_IN=7d

# Performance / montée en charge (facultatif, valeurs par défaut adaptées au développement local)
# NODE_ENV=production                 # active la mise en cache longue durée des fichiers statiques
# WEB_CONCURRENCY=4                   # nombre de processus workers pour "npm run start:cluster" (par défaut : nb de cœurs CPU)
# DB_POOL_SIZE=20                     # connexions MySQL simultanées par processus. Attention : (DB_POOL_SIZE x nb de workers) doit rester sous max_connections côté MySQL
# DB_QUEUE_LIMIT=200                   # requêtes en attente dans le pool avant refus rapide (0 = pas de file)
# DASHBOARD_CACHE_TTL_MS=1000            # cache très court du dashboard par utilisateur (250ms minimum)
# TRUST_PROXY=1                       # à activer uniquement si l'app tourne derrière Nginx/un load balancer
# ALLOWED_ORIGINS=https://votredomaine.com,https://www.votredomaine.com   # liste blanche CORS ; sans cette variable en production, l'API accepte toute origine (voir avertissement au démarrage)

# Connexion MySQL (WAMPserver) — valeurs par défaut d'une installation standard.
# En déploiement Docker (voir docker-compose.yml) : DB_USER/DB_PASSWORD deviennent les
# identifiants d'un compte MySQL dédié à l'application (pas root), créé automatiquement
# par l'image mysql officielle. DB_HOST/DB_PORT sont alors ignorés (surchargés par
# docker-compose.yml pour pointer vers le service "mysql" du réseau Docker interne).
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=samafacture
# Mot de passe root MySQL — utilisé uniquement par docker-compose.yml pour initialiser le
# conteneur MySQL (administration/maintenance). L'application elle-même ne s'y connecte
# jamais : elle utilise DB_USER/DB_PASSWORD ci-dessus (compte aux droits limités).
DB_ROOT_PASSWORD=

# URL publique de l'application (utilisée dans les liens envoyés par email)
APP_URL=http://localhost:4000

# Connexion Google (facultatif) — laissez vide pour désactiver le bouton "Se connecter avec Google".
# À créer sur https://console.cloud.google.com/apis/credentials (identifiant OAuth 2.0, type
# "Application Web"), avec http://localhost:4000 dans les origines JavaScript autorisées.
GOOGLE_CLIENT_ID=

# Envoi d'email pour "mot de passe oublié" (facultatif). Sans ces réglages, le lien de
# réinitialisation s'affiche dans la console du serveur au lieu d'être envoyé par email
# (pratique pour tester en local). Exemple avec Gmail : host smtp.gmail.com, port 587,
# utilisateur = votre adresse Gmail, mot de passe = un "mot de passe d'application" Google
# (pas votre mot de passe habituel).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=SamaFacture Pro <no-reply@samafacture.pro>

# Paiement des abonnements (facultatif). Sans ces réglages, les boutons de paiement restent
# masqués et un simple sélecteur de plan (gratuit, pour les tests) reste disponible.

# Wave Business — créez un compte sur https://business.wave.com, section "Developers".
# Nécessite votre NINEA (validation en 48-72h). Frais : ~1% par transaction (Sénégal).
WAVE_API_KEY=
WAVE_SIGNING_SECRET=

# PayDunya — agrégateur qui gère Orange Money ET carte bancaire (Visa/Mastercard) en une
# seule intégration. Créez un compte sur https://paydunya.com, puis une "App" dans le
# tableau de bord pour obtenir ces 3 clés. PAYDUNYA_MODE=test pour tester sans argent réel
# (obligatoire tant que votre compte n'est pas validé en mode live).
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test

# Délai (en heures) au bout duquel une tentative de paiement d'abonnement restée bloquée
# en "en_attente" (webhook jamais reçu, page fermée avant paiement) est marquée "expiree".
PAIEMENT_EXPIRATION_HEURES=24

# Sauvegarde automatique quotidienne de la base de données (mysqldump). Activée par
# défaut — aucune configuration n'est requise pour que ça fonctionne avec WAMPserver.
BACKUP_ENABLED=true
# Heure de la journée (0-23) à laquelle la sauvegarde se déclenche. 2 = 2h du matin.
BACKUP_HOUR=2
# Nombre de jours de sauvegardes conservées avant suppression automatique des plus anciennes.
BACKUP_RETENTION_DAYS=14
# Dossier de destination des sauvegardes (relatif au dossier server/, ou chemin absolu).
BACKUP_DIR=./backups
# Chemin vers mysqldump.exe. Laissez tel quel si mysqldump est accessible depuis n'importe
# où (variable PATH système). Avec WAMPserver, indiquez le chemin complet, par exemple :
# C:\wamp64\bin\mysql\mysql8.0.31\bin\mysqldump.exe
MYSQLDUMP_PATH=mysqldump
# Mettre à true pour lancer immédiatement une vérification au démarrage. Une archive
# déjà réussie aujourd'hui sur une autre instance n'est pas recréée.
BACKUP_ON_STARTUP=false

# Suivi des erreurs en production (facultatif). Créez un compte gratuit sur https://sentry.io,
# créez un projet "Node.js", et collez l'URL "DSN" fournie. Sans ça, les erreurs restent
# journalisées uniquement dans la console du serveur (comportement actuel par défaut).
SENTRY_DSN=

# Assistant Comptable IA (facultatif). Sans cette clé, la page "Assistant IA" reste
# accessible mais affiche un message expliquant que la fonctionnalité n'est pas encore
# configurée, au lieu de planter. Créez une clé sur https://console.anthropic.com
# (section "API Keys"). Facturé à l'usage par Anthropic — surveillez votre consommation
# les premiers jours, surtout si l'application est ouverte au public.
ANTHROPIC_API_KEY=
# Modèle utilisé par l'assistant. claude-haiku-4-5-20251001 est nettement moins cher et
# largement suffisant pour répondre à des questions sur les factures/ventes ; passez à
# claude-sonnet-5 si vous voulez des réponses plus fines (conseils, relances) au prix
# d'un coût par message plus élevé.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001


# Scalabilité multi-instance (recommandé en production dès que plusieurs conteneurs API sont utilisés)
# REDIS_URL=redis://redis:6379
# DB_POOL_SIZE=10                 # par worker/processus ; dimensionner pour rester sous max_connections MySQL
# WEB_CONCURRENCY=2               # par conteneur ; adapter aux CPU/mémoire réellement alloués

# Profil de dimensionnement recommandé pour plusieurs instances :
# 3 conteneurs API × 2 workers × 10 connexions = 60 connexions MySQL API.
# Ajoutez les connexions des PDF workers et une marge avant de fixer MySQL max_connections.
# Le test k6 est dans load/k6-10000.js et doit être exécuté sur un environnement de staging dédié.
# Documentation interactive de l'API (/api/docs). Désactivée par défaut dès que
# NODE_ENV=production (elle décrit les routes internes — pas de raison de l'exposer
# publiquement par défaut). Mettez ENABLE_API_DOCS=true pour la réactiver explicitement en
# production si besoin (ex: API destinée à des partenaires). Sans effet en développement,
# où elle reste activée par défaut (DISABLE_API_DOCS=true pour la couper en local).
ENABLE_API_DOCS=false

PDF_JOBS_DIR=./pdf-jobs
PDF_QUEUE_KEY=samafacture:pdf:queue
PDF_JOB_TTL_SECONDS=3600

# Durées de protection du runtime (millisecondes)
HEALTH_TIMEOUT_MS=3000
SHUTDOWN_TIMEOUT_MS=10000
