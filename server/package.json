    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express-rate-limit": "^7.4.0",
    "morgan": "^1.12.1",
    "google-auth-library": "^9.14.1",
    "nodemailer": "^10.5.0",
    "compression": "^1.8.2",
    "qrcode": "^1.5.4",
    "@sentry/node": "^11.12.0",
    "puppeteer": "^25.17.0",
